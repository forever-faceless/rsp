# Copy this file to .env.local and fill it in. Never commit .env.local.

# ---- Admin login (the owner signs in with these at /admin) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Long random string that signs the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# ---- Database ----
# Local file while developing or when hosting on your own server:
DATABASE_URL=file:./data/local.db
# Turso in production (leave TURSO_AUTH_TOKEN empty for a local file):
# DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# ---- File storage ----
# Photos, brochures and videos are written to this folder unless a blob store is connected.
UPLOAD_DIR=./data/uploads
# Set automatically by Vercel when a Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# ---- Public address of the site (sitemap, link previews) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Map imagery (optional) ----
# Satellite tiles default to Esri World Imagery. To use another provider, give a
# standard {z}/{x}/{y} tile address and the credit line it requires.
# NEXT_PUBLIC_SATELLITE_TILES=https://api.maptiler.com/tiles/satellite-v2/{z}/{x}/{y}.jpg?key=YOUR_KEY
# NEXT_PUBLIC_SATELLITE_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
# NEXT_PUBLIC_SATELLITE_MAX_ZOOM=20
